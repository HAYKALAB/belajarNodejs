<div class="container mt-3">
  <div class="row">
    <div class="col-md-6">
      <h2>form tambah data contact</h2>

      <% if (typeof erors != 'undefined') { %>
      <div class="alert theme-danger" role="alert">
   
     
      <ul>
        <% erors.forEach(error => { %>
         <li><%= error.msg %></li>
        <% }) %>
         </div>
      </ul>
      <% } %>
      <form method="post" action="/contact">
        <div class="mb-3">
          <label for="nama" class="form-label">Nama</label>
          <input
            type="text"
            class="form-control"
            id="nama"
            name="nama"
            required
          />
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input
            type="email"
            class="form-control"
            id="email"
            name="email"
            required
          />
        </div>

        <div class="mb-3">
          <label for="nohp" class="form-label">No Hp</label>
          <input
            type="text"
            class="form-control"
            id="nohp"
            name="nohp"
            required
          />
        </div>

        <button type="submit" class="btn-solid theme-primary">
          Tambah Data Contact
        </button>
      </form>
    </div>
  </div>
</div>
